# Amos CI — drop-in workflow for amos-* repositories.
#
# To use this in a repo:
#   1. Copy this file to .github/workflows/amos-ci.yml in that repository
#      (drop the .sample extension so GitHub Actions picks it up).
#   2. Confirm the owner/repo below still points at the central amos-ci
#      repo (update it if the org/repo name changes).
#   3. Pin @v1 to the amos-ci release you want this repo to run —
#      do not point at @main, so a bad change there can't break every amos-*
#      repo's CI at once.
#   4. Add any repo-specific jobs/steps below the shared one — this file is
#      a normal caller workflow, so local jobs can sit alongside the `uses:`
#      job without affecting it.

name: Amos CI

on:
  pull_request:
    types:
      - opened
      - reopened
      - synchronize
      - edited
      - ready_for_review
      - closed

jobs:
  amos-ci:
    name: Amos CI
    uses: bentideswell/amos-ci/.github/workflows/amos-ci.yml@v1
    permissions:
      contents: write
      issues: write
      pull-requests: write

  # Repo-specific jobs go here, e.g.:
  #
  # custom-check:
  #   name: Custom check
  #   runs-on: ubuntu-latest
  #   steps:
  #     - uses: actions/checkout@v4
  #     - run: ./scripts/repo-specific-check.sh
